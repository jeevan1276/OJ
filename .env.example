# ─── OJ Platform — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in all required values before running
# docker-compose up --build

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_secure_password
MONGO_DB=oj

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_jwt_secret_here

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Compiler Microservice ────────────────────────────────────────────────────
# URL the backend uses to reach the compiler (use service name inside Docker)
COMPILER_URL=http://localhost:8000/compile
# Shared secret between backend and compiler (Task 8 security)
COMPILER_API_KEY=your_strong_shared_compiler_secret

# ─── Sandbox (Docker runner) ──────────────────────────────────────────────────
SANDBOX_RUNNER_IMAGE=oj-runner:latest
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_MS=25000
# Optional: path to seccomp profile JSON
# SANDBOX_SECCOMP_PROFILE=/path/to/seccomp.json

# ─── BullMQ Worker ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── Semantic Cache (AI) ──────────────────────────────────────────────────────
# Cosine similarity threshold for cache hit (0.0–1.0)
SEMANTIC_CACHE_THRESHOLD=0.92
# Max number of entries to keep in memory
SEMANTIC_CACHE_MAX_SIZE=200

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
